# Copia este archivo a .env para definir credenciales propias:
#   cp .env.example .env   (y edita los valores)
# docker-compose lee .env automaticamente; sin el, usa estos defaults de
# desarrollo local. El archivo .env esta en .gitignore: nunca se versiona.
POSTGRES_USER=lacda
POSTGRES_PASSWORD=lacda_pass
POSTGRES_DB=loans
